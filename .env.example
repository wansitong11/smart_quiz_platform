# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key
# AI 价格同步源：可选外部 URL；未配置时回退本地文件或内置价目表
# APP_AI_COST_PRICE_SYNC_URL=https://example.com/ai-model-prices.json
# APP_AI_COST_PRICE_LOCAL_PATH=/absolute/path/ai-model-prices.yml

# ================================
# 登录鉴权（Spring Security + JWT）
# ================================
# JWT 签名密钥，至少 32 字节。生成：openssl rand -base64 48
APP_AUTH_JWT_SECRET=change_me_at_least_32_bytes_jwt_secret
# 签发者标识，必须是 URL 形态，一般不用改
# APP_AUTH_JWT_ISSUER=https://smart-quiz-platform
# 初始管理员密码；留空则首次启动随机生成并打印到日志（务必只用于本地）
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# 本地开发走 http，Cookie 不能带 Secure；线上（HTTPS）必须改成 true 或不设置（默认 true）
APP_AUTH_COOKIE_SECURE=false
# 本地需要打开 Swagger UI 时置 true
APP_AUTH_SWAGGER_PUBLIC=true
# 是否开放自助注册（注册按钮）
APP_AUTH_REGISTRATION_ENABLED=true
# 自助注册配额：同一 IP 24 小时内最多注册数 / 全站每日最多注册数（0 = 不限制）
APP_AUTH_REGISTER_MAX_PER_IP_PER_DAY=3
APP_AUTH_REGISTER_MAX_GLOBAL_PER_DAY=5

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5
# 免费识图默认 GLM-4.6V-Flash；GLM-4.7-Flash 作为可绑定的免费文本备选
PROVIDER_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PROVIDER_GLM_FREE_MODEL=glm-4.7-flash
PROVIDER_GLM_VISION_FREE_MODEL=glm-4.6v-flash
# 硅基流动（免费文本 Qwen3-8B + 低成本文本 Qwen3-14B + 识图 Qwen3-VL-8B + Embedding BGE-M3）
PROVIDER_SILICONFLOW_API_KEY=
PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
PROVIDER_SILICONFLOW_CHEAP_TEXT_MODEL=Qwen/Qwen3-14B
PROVIDER_SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
PROVIDER_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# 音频免费 Provider（可选）：价格表没有音频记录时，只有与这里的 Provider 一致才按免费限流
# APP_AI_FREE_AUDIO_PROVIDER=dashscope
# 语音 TTS/ASR 在价格表和免费判定中的 Provider 标识（默认 dashscope）
# APP_VOICE_QWEN_PROVIDER=dashscope
# 免费档默认模型：文本 Qwen3-8B（8 并发），识图 GLM-4.6V-Flash（1 并发）
# APP_AI_FREE_TEXT_PROVIDER=siliconflow-free
# APP_AI_FREE_VISION_PROVIDER=glm-vl-free
# 免费 Provider 级并发覆盖；未填时使用 text/vision/embedding/audio 的全局默认值
# APP_AI_FREE_MODEL_SILICONFLOW_TEXT_PERMITS=8
# APP_AI_FREE_MODEL_GLM_TEXT_PERMITS=1
# APP_AI_FREE_MODEL_GLM_VISION_PERMITS=1
# 付费识图 Provider 的独立并发上限；siliconflow-vl 在 3 并发下实测会触发 429
# APP_AI_PROVIDER_SILICONFLOW_VL_PERMITS=1

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与根目录 docker-compose.yml 对齐（本地 bootRun 连 compose 起的依赖时勿改）
# ================================

# PostgreSQL（compose 默认：库 smart-quiz / 用户 postgres / 密码 password / 映射端口 5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart-quiz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# RustFS / S3 兼容存储（docker-compose.dev.yml 默认凭证为 rustfsadmin，API 映射 9000）
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=rustfsadmin
APP_STORAGE_SECRET_KEY=rustfsadmin
APP_STORAGE_BUCKET=smart-quiz

# AI 模型配置：授权用户与系统任务默认走 3.8；免费用户由 dashscope-3.7 档位承接
AI_MODEL=qwen3.8-flash
AI_VISION_MODEL=qwen3.8-flash
# 免费用户档位 Provider（对应 app.ai.providers 中的 Provider ID）
APP_AI_TIER_FREE_TEXT_PROVIDER=dashscope-3.7
APP_AI_TIER_FREE_VISION_PROVIDER=dashscope-3.7-vl
# 免费用户共享的月度 AI 成本总量（人民币）
APP_AI_QUOTA_MONTHLY_TOTAL_CNY=100

# 知识库识图（JPG/PNG、扫描 PDF、DOCX 内嵌图）
# APP_AI_RAG_OCR_ENABLED=true
# APP_AI_RAG_OCR_MAX_PAGES=10
# APP_AI_RAG_OCR_MAX_DOCX_IMAGES=40
# 试卷与知识库共用的视觉并发上限
# APP_AI_VISION_MAX_IN_FLIGHT=4
# 知识库向量化任务 worker 数
# APP_STREAM_KB_VECTORIZE_WORKERS=4

# 试卷切题（可选）
# 单批送模型的材料字符上限；超出后按题号切块分批处理
# APP_PAPER_EXTRACTION_BATCH_CHAR_LIMIT=3000
# 材料整体字符上限
# APP_PAPER_EXTRACTION_MAX_PAPER_CHARS=30000
# 单份材料允许抽取的最大题目数
# APP_PAPER_EXTRACTION_MAX_QUESTIONS=80

# 答案解析每批题数（1~10，默认 3；过小会增加 RPM 压力，过大增加长 JSON 截断风险）
# APP_PAPER_ANALYSIS_BATCH_SIZE=3
# 当前分钟 RPM 已满时最多等待多久再继续（默认覆盖完整窗口）
# APP_PAPER_ANALYSIS_RATE_LIMIT_MAX_WAIT=65s

# 试卷页识别并发（默认 3；必须同时不超过 APP_AI_VISION_MAX_IN_FLIGHT 和 PAPER_IMPORT 预算并发）
# APP_PAPER_RECOGNITION_POOL_SIZE=3
# APP_AI_BUDGET_PAPER_IMPORT_CONCURRENCY=3
# 同一页输出被截断时最多允许的定向重试次数
# APP_PAPER_RECOGNITION_OUTPUT_TRUNCATED_RETRY_MAX_COUNT=1

# 语音面试（可选）：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000
# 应用启动时是否预热开场白音频；会调用云端 TTS，默认关闭
# APP_VOICE_OPENING_AUDIO_WARMUP_ENABLED=false

# 语音面试上下文压缩（默认开启）。enabled=false 是唯一关闭方式，仅本地排查用；
# mode 可选 NONE（不摘要不裁窗口，仍有字符硬预算）/ WINDOW（窗口+硬预算）/ SUMMARY（摘要+窗口+硬预算，默认）
# 预算定义：摘要字符数 + 近期历史格式化后字符数 <= MAX_HISTORY_CHARS，且摘要 <= MAX_SUMMARY_CHARS
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_ENABLED=true
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_MODE=SUMMARY
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_WINDOW_SIZE=20
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_SUMMARY_BATCH_SIZE=10
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_MAX_HISTORY_CHARS=12000
# APP_VOICE_INTERVIEW_CONTEXT_COMPRESSION_MAX_SUMMARY_CHARS=4000
