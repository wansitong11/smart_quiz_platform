# ==============================================================================
# 生产环境变量模板
#   cp deploy/env.prod.example deploy/env.prod
#   填好后：chmod 600 deploy/env.prod
#   deploy/env.prod 已被 .gitignore 忽略，不要提交到 Git
#
# 随机值生成命令（Linux）：
#   openssl rand -base64 36 | tr -d '/+=' | head -c 40
# ==============================================================================

# ---------- 域名 / 时区 ----------
# 只填主机名，不带协议和路径
DOMAIN=quiz.stonev2ray.top
TZ=Asia/Shanghai

# ---------- PostgreSQL ----------
POSTGRES_DB=smart-quiz
POSTGRES_USER=postgres
# 必须替换，长度 >= 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ---------- Redis ----------
# Redis 只在容器内网可达；显存上限按机器规格调（4G 机器建议 768mb）
REDIS_MAXMEMORY=768mb
REDIS_DATABASE=0

# ---------- RustFS 对象存储 ----------
APP_STORAGE_ACCESS_KEY=CHANGE_ME_rustfs_access_key
APP_STORAGE_SECRET_KEY=CHANGE_ME_rustfs_secret_key
RUSTFS_RPC_SECRET=CHANGE_ME_rustfs_rpc_secret
APP_STORAGE_BUCKET=smart-quiz
APP_STORAGE_REGION=us-east-1
# 仅在需要临时进 9001 控制台时改成 true（同时要在 compose 里临时映射端口）
RUSTFS_CONSOLE_ENABLE=false

# ---------- AI ----------
AI_BAILIAN_API_KEY=sk-CHANGE_ME
AI_MODEL=qwen3.5-flash
# 用于加密运行时 Provider 配置里的 API Key。部署后必须保持不变，否则已存密钥无法解密。
APP_AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME_encryption_key

# ---------- 登录鉴权 ----------
# JWT 签名密钥，至少 32 字节随机串（openssl rand -base64 48）
APP_AUTH_JWT_SECRET=CHANGE_ME_at_least_32_bytes
# 签发者标识，必须是 URL 形态
APP_AUTH_JWT_ISSUER=https://smart-quiz-platform
# 初始管理员：只在用户表为空时创建一次；留空则随机生成并打印到启动日志
APP_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# 是否开放自助注册。开放后任何人都能注册账号并使用 AI 能力（消耗额度），
# 只给少数人用时建议设为 false，改为管理员在「账号管理」里建号
APP_AUTH_REGISTRATION_ENABLED=true

# 可选 Provider
PROVIDER_KIMI_API_KEY=
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_GLM_API_KEY=

# ---------- 跨域 / WebSocket ----------
# 必须与浏览器实际访问的源完全一致（协议+域名，不带路径）
CORS_ALLOWED_ORIGINS=https://quiz.stonev2ray.top

# ---------- JVM ----------
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8

# ---------- 业务参数 ----------
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8

# ---------- 镜像（改用 ACR 发布时填写）----------
# APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/smart-quiz-app:v1
# FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/smart-quiz-frontend:v1
