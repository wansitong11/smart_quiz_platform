# 注意：现在的前端镜像是「本地 pnpm build 出 dist，容器只 COPY」的模式
# （见 frontend/Dockerfile 与 deploy/docker-compose.server.yml）。
# 所以 **dist 必须参与构建，不能再忽略** —— 之前这里写着 dist，
# 结果本地/CI 用 context: frontend 构建时报 "/dist": not found。

# 依赖与构建缓存不需要进镜像
node_modules
build
.pnpm-store

# Development files
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Test coverage
coverage

# Documentation
*.md
!README.md
